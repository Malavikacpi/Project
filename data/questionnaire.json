    {
      "number": "1",
      "title": "Maximum Temperature",
      "questions": [
        {
          "type": "choice",
          "number": "1.1",
          "text": "At what ambient temperature does thermal derating typically begin in a distribution system?",
          "unit": "°C",
          "options": [
            "<35°C",
            "35–40°C",
            "40–45°C",
            "45–50°C",
            ">50°C",
            "Other (please specify)",
            "Not sure / insufficient data"
          ]
        },
        {
          "type": "choice",
          "number": "1.2",
          "text": "Above the thermal derating threshold, what is the typical reduction in load-serving capacity for every 1°C increase in ambient temperature?",
          "unit": "% per °C",
          "options": [
            "<0.5% per °C",
            "0.5–1% per °C",
            "1–2% per °C",
            "2–3% per °C",
            ">3% per °C",
            "Other (please specify)",
            "Not sure / insufficient data"
          ]
        },
        {
          "type": "choice",
          "number": "1.3",
          "text": "What is the maximum thermal derating typically allowed before the distribution asset enters protective shutdown or its operation is interrupted?",
